[Unit]
Description=Homer dashboard (static link page)

[Container]
Image=docker.io/b4bz/homer:latest
ContainerName=homer
Network=travel-home-lab.network
# %h is expanded by systemd (repo must be at ~/travel-home-lab).
# The image serves /www via nginx on 8080; only the assets dir needs the config.
Volume=%h/travel-home-lab/homer:/www/assets:z
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=default.target
