[Unit]
Description=Glances system monitor (web mode)
# Needed to report container state.
Requires=podman.socket
After=podman.socket

[Container]
Image=docker.io/nicolargo/glances:latest
ContainerName=glances
Network=travel-home-lab.network
Environment=GLANCES_OPT=-w
PodmanArgs=--pid=host
# %t expands to /run/user/1000.
# No mode suffix: podman 5.4.2 rejects the compose file's ":roz" (mount options
# must be comma-separated — "ro,z"), and compose silently dropped it, so these
# were plain rw binds.
Volume=%t/podman/podman.sock:/run/user/1000/podman/podman.sock
Volume=/etc/os-release:/etc/os-release
AutoUpdate=registry

[Service]
# compose had no restart policy; adding one is a deliberate behaviour change.
Restart=always

[Install]
WantedBy=default.target
