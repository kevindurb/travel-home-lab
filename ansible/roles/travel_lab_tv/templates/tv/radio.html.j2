<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Travel Lab &mdash; Radio</title>
  <link rel="stylesheet" href="style.css">
</head>
<body data-page="radio">
  <header class="top">
    <a class="back" href="index.html" data-back>&larr; Back</a>
    <div class="brand">RADIO</div>
    <div class="when">
      <div class="clock" id="clock">--:--</div>
      <div class="date" id="date"></div>
    </div>
  </header>

  <main class="radio">
    <section class="radio-now">
      <button class="radio-toggle" data-play data-playing="false" aria-label="Play">
        <svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M8 5v14l11-7z" fill="currentColor"/>
        </svg>
        <svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 5h4v14H6zM14 5h4v14h-4z" fill="currentColor"/>
        </svg>
      </button>

      <div class="radio-now-copy">
        <div class="radio-now-label">Now playing</div>
        <div class="radio-now-name" data-now-name>Pick a station</div>
        <div class="radio-now-sub" data-now-sub>Use the arrow keys and Enter</div>
      </div>

      <button class="radio-skip" data-prev aria-label="Previous station">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M7 5v14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <path d="M18 5l-9 7 9 7z" fill="currentColor"/>
        </svg>
      </button>
      <button class="radio-skip" data-next aria-label="Next station">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M17 5v14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <path d="M6 5l9 7-9 7z" fill="currentColor"/>
        </svg>
      </button>

      <label class="radio-volume">
        <span>Vol</span>
        <input type="range" min="0" max="1" step="0.01" value="0.7" data-volume aria-label="Volume">
      </label>
    </section>

    <div class="radio-stations">
      {% for station in travel_lab_radio_stations %}
      <button class="station"
              data-station
              data-url="{{ station.url }}"
              data-name="{{ station.name }}"
              data-subtitle="{{ station.subtitle }}"
              style="--accent: {{ station.accent }};"
              {% if not loop.first %}tabindex="-1"{% endif %}>
        <span class="station-name">{{ station.name }}</span>
        <span class="station-sub">{{ station.subtitle }}</span>
      </button>
      {% endfor %}
    </div>
  </main>

  <footer class="hints">
    <span><b>Enter</b> play</span>
    <span><b>Space</b> pause</span>
    <span><b>+ / -</b> volume</span>
    <span><b>Backspace</b> / <b>Esc</b> back</span>
  </footer>

  <audio data-audio preload="none"></audio>
  <script src="app.js"></script>
</body>
</html>
