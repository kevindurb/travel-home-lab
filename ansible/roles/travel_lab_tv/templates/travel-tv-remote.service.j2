[Unit]
Description=Travel TV phone remote API

[Service]
Type=simple
Environment=XDG_RUNTIME_DIR=/run/user/{{ travel_lab_uid }}
Environment=TRAVEL_TV_REMOTE_SOCKET={{ travel_lab_tv_remote_socket }}
Environment=TRAVEL_TV_REMOTE_SETTLE_MS={{ travel_lab_tv_remote_settle_ms }}
ExecStart=/usr/bin/python3 {{ travel_lab_home }}/.local/bin/travel-tv-remote
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
