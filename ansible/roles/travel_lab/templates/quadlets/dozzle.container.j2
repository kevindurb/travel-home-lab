[Unit]
Description=Dozzle container log viewer
# Needed to read container logs.
Requires=podman.socket
After=podman.socket

[Container]
Image={{ travel_lab_images.dozzle }}
ContainerName=dozzle
Network={{ travel_lab_network }}.network
Volume=dozzle_data.volume:/data
# Read-write bind of the rootless podman socket (needed to read logs).
Volume=%t/podman/podman.sock:/var/run/docker.sock
AutoUpdate={{ travel_lab_auto_update_value }}

[Service]
Restart=always

[Install]
WantedBy=default.target
