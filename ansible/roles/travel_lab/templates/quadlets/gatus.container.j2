[Unit]
Description=Gatus uptime dashboard

[Container]
Image={{ travel_lab_images.gatus }}
ContainerName=gatus
Network={{ travel_lab_network }}.network
Environment=GATUS_LOG_LEVEL=DEBUG
Environment=GATUS_CONFIG_PATH=/config
Volume=gatus_data.volume:/data
Volume=%h/.config/gatus/config.yml:/config/config.yaml:z
AutoUpdate={{ travel_lab_auto_update_value }}

[Service]
Restart=always

[Install]
WantedBy=default.target
