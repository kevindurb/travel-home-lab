# Rendered by Ansible from ansible/group_vars/travel_lab.yml (travel_lab_domain).
# Do not edit on the Pi: changes are overwritten on the next `deploy`.
#
# Homer reads this file from /www/assets (bind-mounted from ~/.config/homer).
# Every link is served by Caddy with tls internal on the travel-home-lab
# network, so the URLs are the public *.<domain> names.
---
title: "Travel Lab"
subtitle: "Raspberry Pi 4"
header: true
footer: false
columns: 2

defaults:
  layout: list
  colorTheme: auto

services:
  - name: "Media"
    icon: "fas fa-film"
    items:
      - name: "Jellyfin"
        subtitle: "Film & TV library"
        icon: "fas fa-play-circle"
        url: "https://jellyfin.{{ travel_lab_domain }}"
      - name: "Kiwix"
        subtitle: "Offline Wikipedia & more"
        icon: "fas fa-book"
        url: "https://kiwix.{{ travel_lab_domain }}"

  - name: "Ops"
    icon: "fas fa-heartbeat"
    items:
      - name: "Gatus"
        subtitle: "Uptime monitoring"
        icon: "fas fa-heartbeat"
        url: "https://gatus.{{ travel_lab_domain }}"
      - name: "Glances"
        subtitle: "System monitor"
        icon: "fas fa-tachometer-alt"
        url: "https://glances.{{ travel_lab_domain }}"
      - name: "Dozzle"
        subtitle: "Container logs"
        icon: "fas fa-file-code"
        url: "https://dozzle.{{ travel_lab_domain }}"
      - name: "whoami"
        subtitle: "Test endpoint"
        icon: "fas fa-user-secret"
        url: "https://whoami.{{ travel_lab_domain }}"
