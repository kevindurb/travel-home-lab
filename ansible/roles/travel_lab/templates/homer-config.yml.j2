# Rendered by Ansible from ansible/group_vars/travel_lab.yml.
# Do not edit on the Pi: changes are overwritten on the next `deploy`.
#
# Homer reads this file from /www/assets (bind-mounted from ~/.config/homer).
# Every link points at a Tailscale Service, i.e. the public
# <service>.<tailnet-domain> name served by tailscaled with a real TLS cert.
# The service names come from travel_lab_tailscale_services, so they cannot
# drift from the `tailscale serve` declarations.
---
title: "Travel Lab"
subtitle: "Raspberry Pi 4"
header: true
footer: false
columns: 2

defaults:
  layout: list
  colorTheme: auto

services:
  - name: "Media"
    icon: "fas fa-film"
    items:
      - name: "Jellyfin"
        subtitle: "Film & TV library"
        icon: "fas fa-play-circle"
        url: "https://{{ travel_lab_tailscale_services.jellyfin.service }}.{{ travel_lab_tailnet_domain }}"
      - name: "Kiwix"
        subtitle: "Offline Wikipedia & more"
        icon: "fas fa-book"
        url: "https://{{ travel_lab_tailscale_services.kiwix.service }}.{{ travel_lab_tailnet_domain }}"

  - name: "Ops"
    icon: "fas fa-heartbeat"
    items:
      - name: "Gatus"
        subtitle: "Uptime monitoring"
        icon: "fas fa-heartbeat"
        url: "https://{{ travel_lab_tailscale_services.gatus.service }}.{{ travel_lab_tailnet_domain }}"
      - name: "Glances"
        subtitle: "System monitor"
        icon: "fas fa-tachometer-alt"
        url: "https://{{ travel_lab_tailscale_services.glances.service }}.{{ travel_lab_tailnet_domain }}"
      - name: "Dozzle"
        subtitle: "Container logs"
        icon: "fas fa-file-code"
        url: "https://{{ travel_lab_tailscale_services.dozzle.service }}.{{ travel_lab_tailnet_domain }}"
      - name: "whoami"
        subtitle: "Test endpoint"
        icon: "fas fa-user-secret"
        url: "https://{{ travel_lab_tailscale_services.whoami.service }}.{{ travel_lab_tailnet_domain }}"
